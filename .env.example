# ==============================================================================
# PlaylistShift - Environment Variables
# Copy this file to .env.local for local development. Never commit .env or secrets!
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Secret (Required: min 32 chars for secure AES/JWT encrypted cookie session)
# Generate one using: openssl rand -base64 32
SESSION_SECRET=playlistshift_session_secret_change_in_production_min_32_characters_long

# ------------------------------------------------------------------------------
# Google OAuth 2.0 & YouTube Data API v3
# ------------------------------------------------------------------------------
# Create project at: https://console.cloud.google.com/
# Enable: YouTube Data API v3
# Credentials: OAuth 2.0 Client ID (Web application)
# Authorized redirect URIs:
#   Local: http://localhost:3000/api/auth/google/callback
#   Production: https://your-domain.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Optional: Server-side YouTube Data API v3 Key (Used for public song search cache/quota fallback before user OAuth)
YOUTUBE_API_KEY=your_optional_youtube_data_api_v3_key_here

# ------------------------------------------------------------------------------
# Spotify Web API (Official Provider Adapter)
# ------------------------------------------------------------------------------
# Create app at: https://developer.spotify.com/dashboard
# If disabled or unconfigured, the app falls back seamlessly to CSV/Text & manual import
SPOTIFY_INTEGRATION_ENABLED=true
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# Google AdSense (Disabled by default per Google policy)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# ------------------------------------------------------------------------------
# Google Analytics 4 (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=

